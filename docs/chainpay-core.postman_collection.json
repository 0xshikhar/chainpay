						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"batchIdempotencyKey\": \"batch-key-999\",\n  \"payouts\": [\n    {\n      \"accountId\": \"{{accountId}}\",\n      \"assetId\": \"{{assetId}}\",\n      \"destinationAddress\": \"0x70997970C51812dc3A010C7d01b50e0d17dc79C8\",\n      \"amount\": 10000000\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/payouts/batch",
