					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							},
							{
								"key": "Idempotency-Key",
								"value": "idemp-key-1001"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"assetId\": \"{{assetId}}\",\n  \"destinationAddress\": \"0x70997970C51812dc3A010C7d01b50e0d17dc79C8\",\n  \"amount\": 50000000\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/payouts",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"payouts"
							]
						}
					}
				},
